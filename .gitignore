# ── 后端 ──────────────────────────────
backend/bin/
backend/logs/
*.exe
*.exe~
*.test

# 本地配置含数据库口令，不进版本库；模板见同目录 config.example.yaml
backend/config.yaml
backend/test/testdata/config.yaml

# ── 前端 ──────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# 数据库备份：含全部业务数据，绝不能进版本库
backend/backups/

# 升级包暂存与替换下来的旧产物：含完整可执行程序，同样不进版本库
backend/upgrade/
# 后端托管的前端产物（演练升级/本地静态托管时生成），由构建脚本生成，不进版本库
backend/web/
*.new
frontend/dist.old.*/
frontend/dist.old-*/

# 升级包构建产物（脚本 scripts/build-upgrade-package.mjs 生成，含完整可执行程序）
build/

# ── 脚本产物 ──────────────────────────
scripts/.browser-verify.json
scripts/p3-result.json
.api-smoke.log

# 文档生成流水线的中间产物（HTML / 探针 / 状态文件），成品在 docs/ 下
output/

# ── 编辑器 / 系统 ─────────────────────
.idea/
.vscode/
.workbuddy/
*.swp
.DS_Store
Thumbs.db
